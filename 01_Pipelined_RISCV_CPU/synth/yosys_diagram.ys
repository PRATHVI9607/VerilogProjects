# ============================================================================
#                YOSYS SYNTHESIS SCRIPT - Pipelined RISC-V CPU
# ============================================================================
#
# Purpose: Generate hierarchical block diagrams from RTL source files
#
# Usage:
#   yosys yosys_diagram.ys
#
# Outputs:
#   - riscv_cpu_clean.svg    : Clean hierarchical block diagram
#   - riscv_cpu_pipeline.dot : DOT file for GraphViz
#   - riscv_cpu.rtlil        : RTLIL intermediate representation
#
# ============================================================================

# Step 1: Read Package File First (contains definitions)
read_verilog -sv ../rtl/riscv_pkg.v

# Step 2: Read All Pipeline Stage Modules
read_verilog -sv -I ../rtl ../rtl/instruction_fetch.v
read_verilog -sv -I ../rtl ../rtl/instruction_decode.v
read_verilog -sv -I ../rtl ../rtl/execute.v
read_verilog -sv -I ../rtl ../rtl/memory_stage.v
read_verilog -sv -I ../rtl ../rtl/writeback.v

# Step 3: Read Control Units
read_verilog -sv -I ../rtl ../rtl/forwarding_unit.v
read_verilog -sv -I ../rtl ../rtl/hazard_unit.v

# Step 4: Read Top-Level Module
read_verilog -sv -I ../rtl ../rtl/riscv_cpu.v

# Step 5: Hierarchy Check and Elaborate
# -check: Verify all modules are resolved
# -top:   Set top-level module
hierarchy -check -top riscv_cpu

# Step 6: Generate Block Diagrams
# -notitle: Removes title box for cleaner output
# -format:  Output format (svg, dot, png)
# -prefix:  Output filename prefix
# -colors:  Color scheme (42 is a nice colorful scheme)
# -width:   Include bit widths on wires
# -stretch: Improve layout spacing
show -notitle -format svg -prefix riscv_cpu_clean -colors 42 -width -stretch riscv_cpu

# Step 7: Generate DOT File for Custom Processing
# Can be processed with: dot -Tsvg file.dot -o file.svg
show -notitle -format dot -prefix riscv_cpu_yosys -colors 42 -width riscv_cpu

# Step 8: Print Design Statistics
# Shows cell count, wire count, memory usage
stat -top riscv_cpu

# Step 9: Write RTLIL for Reference/Debug
write_rtlil riscv_cpu.rtlil

# ============================================================================
# NOTE: For cleaner architecture diagrams, use the hand-crafted DOT file:
#   dot -Tsvg riscv_pipeline_clean.dot -o riscv_pipeline_clean.svg
#   dot -Tpng riscv_pipeline_clean.dot -o riscv_pipeline_clean.png
# ============================================================================
